@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="rail">
        <NavMenu />
    </aside>

    <div class="main-column">
        <header class="topbar">
            <span class="brand-title">Turing Arena</span>
            <div class="player" title="Progress preview">
                <span class="lv">Lv 3</span>
                <div class="xp"><i style="width:64%"></i></div>
                <span class="xp-text">640 / 1000 XP</span>
            </div>
        </header>

        <main class="content-area">
            @Body
        </main>
    </div>
</div>
