@page "/auth"
@using TuringMachineVisualizer.Services
@inject SupabaseService Supabase
@inject NavigationManager Nav

<PageTitle>Account</PageTitle>

<div class="auth">
    <div class="panel">
        <h2>Save your progress</h2>
        <p class="muted">An account keeps your custom machines, solver runs and quest progress in Supabase, so you can pick up on any device.</p>
        <p class="mono ok">Your data is private to your account.</p>
    </div>

    <div class="panel">
        <h2>@(_isSignUp ? "Create account" : "Sign in")</h2>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="error-box" role="alert">@_error</div>
        }

        @if (_isSignUp)
        {
            <div class="field">
                <label for="dn">Display name</label>
                <input id="dn" @bind="_displayName" placeholder="Your name" />
            </div>
        }

        <div class="field">
            <label for="em">Email</label>
            <input id="em" type="email" @bind="_email" placeholder="you@example.com" />
        </div>

        <div class="field">
            <label for="pw">Password</label>
            <input id="pw" type="password" @bind="_password" placeholder="••••••••" />
        </div>

        <div class="actions">
            <button type="button" class="primary" @onclick="SubmitAsync" disabled="@_busy">
                @(_busy ? "Working..." : (_isSignUp ? "Create account" : "Sign in"))
            </button>
            <button type="button" class="ghost" @onclick="ToggleMode" disabled="@_busy">
                @(_isSignUp ? "Have an account? Sign in" : "New here? Create an account")
            </button>
        </div>
    </div>
</div>

@code {
    private bool _isSignUp;
    private bool _busy;
    private string _displayName = "";
    private string _email = "";
    private string _password = "";
    private string _error = "";

    private void ToggleMode()
    {
        _isSignUp = !_isSignUp;
        _error = "";
    }

    private async Task SubmitAsync()
    {
        _error = "";
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Email and password are required.";
            return;
        }

        _busy = true;
        try
        {
            var result = _isSignUp
                ? await Supabase.SignUpAsync(_email.Trim(), _password, _displayName.Trim())
                : await Supabase.SignInAsync(_email.Trim(), _password);

            if (!result.Success)
            {
                _error = result.Error ?? "Authentication failed.";
                return;
            }

            Nav.NavigateTo("/");
        }
        finally
        {
            _busy = false;
        }
    }
}
