@using TuringMachineVisualizer.Core
@implements IDisposable

<section class="stage" aria-label="Turing machine arena">
    <div class="hud panel">
        <div class="stat"><span>State</span><b class="@StatusClass">@_tm.State</b></div>
        <div class="stat"><span>Steps</span><b>@_tm.StepCount</b></div>
        <div class="stat"><span>Head position</span><b>@_tm.Head</b></div>
        <div class="stat"><span>Status</span><b class="@StatusClass">@StatusText</b></div>
    </div>

    <div class="panel">
        <div class="tape" role="list" aria-label="Tape">
            @foreach (var (i, s) in _tm.VisibleCells(7))
            {
                <div role="listitem" class="cell @(i == _tm.Head ? "on" : "")">
                    <span class="sym">@(s == Definition.Blank ? "␣" : s.ToString())</span>
                    <span class="idx">@i</span>
                </div>
            }
        </div>
    </div>

    <div class="controls panel">
        <input class="input-field" aria-label="Tape input" @bind="_input" @bind:event="oninput" placeholder="Tape input" />
        <button type="button" class="ghost" @onclick="Reset">Load input</button>
        <button type="button" class="ghost" @onclick="Back" disabled="@(!_tm.CanStepBack)">Step back</button>
        <button type="button" @onclick="StepOnce" disabled="@_tm.IsHalted">Step</button>
        <button type="button" class="primary" @onclick="TogglePlay" disabled="@_tm.IsHalted">@(_cts is null ? "Run" : "Pause")</button>
        <input class="speed" type="range" min="80" max="1000" step="40" @bind="_delay" aria-label="Delay between steps" />
    </div>

    <div class="split">
        <div class="panel">
            <h3>Transition rules</h3>
            <table class="rules">
                <thead><tr><th>State</th><th>Read</th><th>Write</th><th>Move</th><th>Next</th></tr></thead>
                <tbody>
                    @foreach (var r in Definition.Rules)
                    {
                        <tr class="@(r == _tm.LastRule ? "fired" : "")">
                            <td>@r.State</td><td>@r.Read</td><td>@r.Write</td><td>@Arrow(r.Move)</td><td>@r.NextState</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="panel">
            <h3>Step log</h3>
            @if (_log.Count == 0)
            {
                <div class="empty">No steps yet. Press Step or Run.</div>
            }
            else
            {
                <ol class="log">
                    @foreach (var line in _log) { <li>@line</li> }
                </ol>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public MachineDefinition Definition { get; set; } = default!;

    private MachineDefinition? _def;
    private TapeEngine _tm = default!;
    private readonly List<string> _log = new();
    private string _input = "";
    private int _delay = 400;
    private CancellationTokenSource? _cts;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_def, Definition)) return;
        _def = Definition;
        _input = Definition.SampleInput;
        Reset();
    }

    private void Reset()
    {
        Stop();
        _tm = new TapeEngine(Definition, _input);
        _log.Clear();
    }

    private bool Forward()
    {
        if (!_tm.StepForward()) return false;
        var r = _tm.LastRule!;
        _log.Add($"{_log.Count + 1}. in {r.State} read {r.Read}, write {r.Write}, move {Arrow(r.Move)}, go to {r.NextState}");
        return true;
    }

    private void StepOnce() { Stop(); Forward(); }

    private void Back()
    {
        Stop();
        if (_tm.StepBack() && _log.Count > 0) _log.RemoveAt(_log.Count - 1);
    }

    private async Task TogglePlay()
    {
        if (_cts is not null) { Stop(); return; }
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        try
        {
            while (!token.IsCancellationRequested && Forward())
            {
                StateHasChanged();
                await Task.Delay(_delay, token);
            }
        }
        catch (TaskCanceledException) { }
        finally { _cts = null; }
    }

    private void Stop() { _cts?.Cancel(); _cts = null; }

    private static string Arrow(Move m) => m switch { Move.Left => "L", Move.Right => "R", _ => "S" };

    private string StatusText => _tm.Status switch
    {
        RunStatus.Accepted => "Accepted",
        RunStatus.Rejected => "Rejected",
        RunStatus.StepLimitReached => "Step limit",
        RunStatus.Running => "Running",
        _ => "Ready"
    };

    private string StatusClass => _tm.Status switch
    {
        RunStatus.Accepted => "ok",
        RunStatus.Rejected => "bad",
        RunStatus.StepLimitReached => "warn",
        _ => "live"
    };

    public void Dispose() => Stop();
}
